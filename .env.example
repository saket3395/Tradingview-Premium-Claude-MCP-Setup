# Copy to .env and adjust if needed.
# Port for the local dashboard server.
PORT=4178
# Chrome DevTools Protocol endpoint exposed by TradingView Desktop.
TV_CDP=http://127.0.0.1:9222
# Set to 1 to stop the CLI from bringing TradingView to the foreground (osascript activate).
# The dashboard server never activates TradingView; this only affects `npm run tv`.
TV_NO_ACTIVATE=

# NSE data provider access-token JSON file ({"access_token":"...", ...}), used ONLY to fetch the
# real NSE upper/lower circuit limits at TPO Confirm (India). Analysis only; no orders.
# RECOMMENDED: a read-only, long-lived "analytics" token — ~1-year validity, supports the
# market-quote endpoint, and needs NO daily refresh (generate it once from your data provider's
# developer console). A normal daily OAuth access token also works but expires each day.
# Absent/expired -> Confirm falls back to the assumed circuit band (tpo.india.circuitBandPct).
NSE_DATA_TOKEN_FILE=./data/nse_data_token.json

# US market-data credentials (US equities) — used ONLY by the Pattern Analysis tab to fetch real
# 4H/1D/1W/1M bars for US symbols. Analysis only; these are DATA credentials, no trading endpoint
# is ever called. Absent -> US symbols report "no history source" honestly.
# Free plans typically use the IEX feed; set the feed to sip if you are entitled to it.
US_DATA_KEY_ID=
US_DATA_SECRET_KEY=
US_DATA_FEED=iex

# NSE-provider request pacing (shared by every NSE-data caller: the analysis tabs, the 1-minute
# backtest, the Analytics regime model and the TPO Confirm circuit lookup).
# The provider sits behind Cloudflare, whose IP-level block (`error code: 1015`) trips well below
# the documented API quota and lasts minutes. These defaults are empirical — raise the gap /
# lower the ceiling if you still see 429s.
NSE_MIN_GAP_MS=600
NSE_MAX_PER_MIN=60

# --- Backward compatibility -------------------------------------------------------------------
# The legacy variable names still work if you already have them set — each reader prefers the new
# name above and falls back to the old one:
#   NSE_DATA_TOKEN_FILE <- UPSTOX_TOKEN_FILE
#   US_DATA_KEY_ID / US_DATA_SECRET_KEY / US_DATA_FEED <- ALPACA_KEY_ID / ALPACA_SECRET_KEY / ALPACA_FEED
#   NSE_CONCURRENCY / NSE_MIN_GAP_MS / NSE_MAX_PER_MIN <- UPSTOX_CONCURRENCY / UPSTOX_MIN_GAP_MS / UPSTOX_MAX_PER_MIN
